    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst count = items.length;\nconst now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\n\n// 找出各年級/科目的待審核數量\nconst breakdown = {};\nfor (const item of items) {\n  const props = item.json.properties || {};\n  const grade = props['年級']?.select?.name || '未知年級';\n  const subject = props['科目']?.select?.name || '未知科目';\n  const key = `${grade} ${subject}`;\n  breakdown[key] = (breakdown[key] || 0) + 1;\n}\nconst details = Object.entries(breakdown).map(([k, v]) => `  ${k}：${v} 題`).join('\\n');\n\nconst lineMsg = [\n  '【🚨 Mina 題庫最終審核提醒】',\n  `明日截止！還有 ${count} 道題目尚未審核！`,\n  '',\n  '⚠️ 今天是最後機會，明日 01:00 後不審核就不會出現在練習頁面！',\n  '',\n  '分布：',\n  details,\n  '',\n  '請立即登入 Notion 確認題目並勾選「是否發布」！',\n  `提醒時間：${now}`\n].join('\\n');\n\nconst emailBody = [\n  '【🚨 Mina 題庫最終審核提醒 — 明日截止】',\n  '',\n  `⚠️ 目前仍有 ${count} 道題目狀態為「未發布」。`,\n  '今天（每月30日）是最後審核機會，',\n  '明天（31日）01:00 後若仍未審核，這批題目將不會出現在練習頁面。',\n  '',\n  '各年級/科目分布：',\n  details,\n  '',\n  '➡️ 請立即至 Notion 題庫 Database 確認並勾選「是否發布」',\n  '',\n  `提醒時間：${now}`\n].join('\\n');\n\nreturn [{ json: {\n  count,\n  lineMsg,\n  emailSubject: `【🚨 Mina 題庫】明日截止！${count} 道題目仍未審核，請立即處理！`,\n  emailBody\n}}];"
      },
