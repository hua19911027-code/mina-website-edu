{"updatedAt":"2026-06-11T10:02:35.951Z","createdAt":"2026-06-11T10:02:35.951Z","id":"qsqFyfWPEORGAyHp","name":"Flow 4 — 月初封存檢查 (Mina)","description":null,"active":false,"isArchived":false,"nodes":[{"id":"f4-n1-sched","name":"每月1日 07:00","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[0,300],"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 7 1 * *"}]}}},{"id":"f4-n2-calc","name":"計算月份","type":"n8n-nodes-base.code","typeVersion":2,"position":[240,300],"parameters":{"jsCode":"const now = new Date();\nconst currYear = now.getFullYear();\nconst currMon  = now.getMonth() + 1;\n// 本月 yearMonth\nconst currYM = `${currYear}${String(currMon).padStart(2,'0')}`;\n// 上個月 yearMonth\nconst prevYear = currMon === 1 ? currYear - 1 : currYear;\nconst prevMon  = currMon === 1 ? 12 : currMon - 1;\nconst prevYM   = `${prevYear}${String(prevMon).padStart(2,'0')}`;\n// 本月第一天 / 最後一天\nconst firstDay = new Date(currYear, currMon - 1, 1).toISOString().split('T')[0];\nconst lastDay  = new Date(currYear, currMon, 0).toISOString().split('T')[0];\nreturn [{ json: { currYM, prevYM, firstDay, lastDay } }];","mode":"runOnceForAllItems"}},{"id":"f4-n3-query-curr","name":"查詢本月已審核題目","type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[480,300],"credentials":{"notionApi":{"id":"AzXLvJt1dpTqr9fB","name":"Notion account"}},"parameters":{"resource":"databasePage","operation":"getAll","databaseId":{"__rl":true,"value":"2502b420-9049-4621-a4b9-99a299a9b922","mode":"id"},"filterType":"manual","filterJson":"{\"and\": [{\"property\": \"是否發布\", \"checkbox\": {\"equals\": true}}, {\"property\": \"已封存\", \"checkbox\": {\"equals\": false}}, {\"property\": \"發布日期\", \"date\": {\"on_or_after\": \"={{ $json.firstDay }}\", \"on_or_before\": \"={{ $json.lastDay }}\"}}]}","returnAll":true,"options":{}}},{"id":"f4-n4-if","name":"本月有已審核題目？","type":"n8n-nodes-base.if","typeVersion":2,"position":[720,300],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"c1","leftValue":"={{ $input.all().length }}","rightValue":0,"operator":{"type":"number","operation":"gt"}}],"combinator":"and"},"options":{}}},{"id":"f4-n5-calc-prev","name":"計算上月日期範圍","type":"n8n-nodes-base.code","typeVersion":2,"position":[960,160],"parameters":{"jsCode":"const { prevYM } = $('計算月份').first().json;\nconst prevYear = parseInt(prevYM.substring(0,4));\nconst prevMon  = parseInt(prevYM.substring(4,6));\nconst firstDay = new Date(prevYear, prevMon - 1, 1).toISOString().split('T')[0];\nconst lastDay  = new Date(prevYear, prevMon, 0).toISOString().split('T')[0];\nreturn [{ json: { firstDay, lastDay } }];","mode":"runOnceForAllItems"}},{"id":"f4-n6-query-prev","name":"查詢上月未封存題目","type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[1200,160],"credentials":{"notionApi":{"id":"AzXLvJt1dpTqr9fB","name":"Notion account"}},"parameters":{"resource":"databasePage","operation":"getAll","databaseId":{"__rl":true,"value":"2502b420-9049-4621-a4b9-99a299a9b922","mode":"id"},"filterType":"manual","filterJson":"{\"and\": [{\"property\": \"是否發布\", \"checkbox\": {\"equals\": true}}, {\"property\": \"已封存\", \"checkbox\": {\"equals\": false}}, {\"property\": \"發布日期\", \"date\": {\"on_or_after\": \"={{ $json.firstDay }}\", \"on_or_before\": \"={{ $json.lastDay }}\"}}]}","returnAll":true,"options":{}}},{"id":"f4-n7-archive","name":"封存上月題目","type":"n8n-nodes-base.notion","typeVersion":2.2,"position":[1440,160],"credentials":{"notionApi":{"id":"AzXLvJt1dpTqr9fB","name":"Notion account"}},"parameters":{"resource":"databasePage","operation":"update","pageId":{"__rl":true,"value":"={{ $json.id }}","mode":"id"},"propertiesUi":{"propertyValues":[{"key":"已封存|checkbox","checkboxValue":true}]}}},{"id":"f4-n8-msg-ok","name":"封存成功訊息","type":"n8n-nodes-base.code","typeVersion":2,"position":[1680,160],"parameters":{"jsCode":"const items = $input.all();\nconst count = items.length;\nconst now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\nreturn [{ json: {\n  count,\n  lineMsg: `【Mina 舊題封存完成 ✅】\\n上月 ${count} 道題目已自動封存\\n新月題目正式啟用\\n時間：${now}`,\n  emailSubject: `【Mina 題庫】上月 ${count} 道題目已封存`,\n  emailBody: `月初自動封存完成\\n\\n封存題數：${count} 道\\n狀態：已封存（可於 Notion 查看，不可刪除）\\n\\n時間：${now}`\n}}];","mode":"runOnceForAllItems"}},{"id":"f4-n9-line-ok","name":"LINE 通知 (封存完成)","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1920,80],"onError":"continueRegularOutput","parameters":{"method":"POST","url":"https://api.line.me/v2/bot/message/broadcast","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer LINE_TOKEN_REMOVED"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\"messages\": [{\"type\": \"text\", \"text\": {{ JSON.stringify($json.lineMsg) }}}]}","options":{"response":{"response":{"neverError":true}}}}},{"id":"f4-n10-msg-warn","name":"新題未就緒訊息","type":"n8n-nodes-base.code","typeVersion":2,"position":[960,440],"parameters":{"jsCode":"const now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\nreturn [{ json: {\n  lineMsg: `【⚠️ Mina 新月題目未就緒】\\n本月新題尚未完成審核！\\n舊題繼續顯示中，請盡快於 Notion 勾選「是否發布」\\n時間：${now}`,\n  emailSubject: `【Mina 題庫警告】本月新題尚未審核，舊題繼續使用`,\n  emailBody: `月初檢查警告\\n\\n本月新題目尚未完成審核（is_published = false）\\n目前仍使用上月題目繼續顯示\\n\\n請盡快登入 Notion 題庫完成審核\\n\\n時間：${now}`\n}}];","mode":"runOnceForAllItems"}},{"id":"f4-n11-line-warn","name":"LINE 警告 (未就緒)","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[1200,440],"onError":"continueRegularOutput","parameters":{"method":"POST","url":"https://api.line.me/v2/bot/message/broadcast","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer LINE_TOKEN_REMOVED"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={\"messages\": [{\"type\": \"text\", \"text\": {{ JSON.stringify($json.lineMsg) }}}]}","options"