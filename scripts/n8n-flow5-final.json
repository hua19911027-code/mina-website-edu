\n\\n所有題目已移至封存狀態，網站不再顯示。`\n}}];", "mode": "runOnceForAllItems"}}, {"id": "f5-n5-line", "name": "LINE 通知", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.4, "position": [960, 180], "onError": "continueRegularOutput", "parameters": {"method": "POST", "url": "https://api.line.me/v2/bot/message/broadcast", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Authorization", "value": "Bearer LINE_CHANNEL_ACCESS_TOKEN_PLACEHOLDER"}, {"name": "Content-Type", "value": "application/json"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={\"messages\": [{\"type\": \"text\", \"text\": {{ JSON.stringify($json.lineMsg) }}}]}", "options": {"response": {"response": {"neverError": true}}}}}, {"id": "f5-n6-email", "name": "Email 通知", "type": "n8n-nodes-base.emailSend", "typeVersion": 2.1, "position": [960, 420], "onError": "continueRegularOutput", "credentials": {"smtp": {"id": "BdOVsK33NdWdJUob", "name": "Gmail SMTP (Mina)"}}, "parameters": {"fromEmail": "hua19911027@gmail.com", "toEmail": "hua19911027@gmail.com, monina1051208@gmail.com", "subject": "={{ $json.emailSubject }}", "emailType": "text", "message": "={{ $json.emailBody }}", "options": {}}, "webhookId": "9504c38f-2df9-43ae-8b82-01f293ffc4f7"}], "connections": {"每年9月30日 22:00": {"main": [[{"node": "查詢所有未封存題目", "type": "main", "index": 0}]]}, "查詢所有未封存題目": {"main": [[{"node": "封存學年題目", "type": "main", "index": 0}]]}, "封存學年題目": {"main": [[{"node": "封存訊息", "type": "main", "index": 0}]]}, "封存訊息": {"main": [[{"node": "LINE 通知", "type": "main", "index": 0}, {"node": "Email 通知", "type": "main", "index": 0}]]}}, "settings": {"executionOrder": "v1"}, "staticData": null, "meta": null, "pinData": null, "versionId": "2a78a5f0-de01-4be6-942d-19facc9c60a3", "activeVersionId": null, "versionCounter": 1, "triggerCount": 0, "shared": [{"updatedAt": "2026-06-11T10:02:35.994Z", "createdAt": "2026-06-11T10:02:35.994Z", "role": "workflow:owner", "workflowId": "ulkXidFkF4cf2wur", "projectId": "TR9S4ARFHuw7aPNS", "p