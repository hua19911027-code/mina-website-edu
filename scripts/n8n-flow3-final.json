  "id": "eb2fMuRRiqSo94AD",
  "name": "Flow 3 — 審核截止提醒 (Mina)",
  "description": null,
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "id": "f3-n1-sched",
      "name": "每月26日 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -500,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 26 * *"
            }
          ]
        }
      }
    },
    {
      "id": "f3-n2-notion",
      "name": "查詢待審核題目",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        -260,
        300
      ],
      "credentials": {
        "notionApi": {
          "id": "AzXLvJt1dpTqr9fB",
          "name": "Notion account"
        }
      },
      "parameters": {
        "resource": "databasePage",
        "operation": "getAll",
        "databaseId": {
          "__rl": true,
          "value": "2502b420-9049-4621-a4b9-99a299a9b922",
          "mode": "id"
        },
        "returnAll": false,
        "limit": 50,
        "options": {},
        "filterType": "manual",
        "filters": {
          "filter": {
            "conditions": [
              {
                "key": "是否發布|checkbox",
                "condition": "checkboxEquals",
                "booleanValue": false
              }
            ]
          }
        }
      }
    },
    {
      "id": "f3-n3-check",
      "name": "有待審核題目？",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-count",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f3-n4-format",
      "name": "格式化提醒訊息",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        160
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst count = items.length;\nconst now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\n\n// 找出各年級/科目的待審核數量\nconst breakdown = {};\nfor (const item of items) {\n  const props = item.json.properties || {};\n  const grade = props['年級']?.select?.name || '未知年級';\n  const subject = props['科目']?.select?.name || '未知科目';\n  const key = `${grade} ${subject}`;\n  breakdown[key] = (breakdown[key] || 0) + 1;\n}\nconst details = Object.entries(breakdown).map(([k, v]) => `  ${k}：${v} 題`).join('\\n');\n\nconst lineMsg = [\n  '【⚠️ Mina 題庫審核提醒】',\n  `距本週六發布尚有 ${count} 道題目未審核！`,\n  '',\n  '分布：',\n  details,\n  '',\n  '請登入 Notion 確認題目並勾選「是否發布」',\n  `提醒時間：${now}`\n].join('\\n');\n\nconst emailBody = [\n  '【Mina 題庫審核截止提醒】',\n  '',\n  `目前尚有 ${count} 道題目狀態為「未發布」，`,\n  '若本週六 01:00 前未審核完成，這批題目將不會出現在練習頁面。',\n  '',\n  '各年級/科目分布：',\n  details,\n  '',\n  '請至 Notion 題庫 Database 確認並勾選「是否發布」',\n  '',\n  `提醒時間：${now}`\n].join('\\n');\n\nreturn [{ json: {\n  count,\n  lineMsg,\n  emailSubject: `【⚠️ Mina 題庫】${count} 道題目待審核，勿忘！`,\n  emailBody\n}}];"
      }
    },
    {
      "id": "f3-n5-line",
      "name": "LINE 提醒管理員",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.line.me/v2/bot/message/broadcast",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer LINE_CHANNEL_ACCESS_TOKEN_PLACEHOLDER"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messages\": [{\"type\": \"text\", \"text\": {{ JSON.stringify($json.lineMsg) }}}]}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "f3-n6-email",
      "name": "Email 提醒管理員",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        520,
        260
      ],
      "credentials": {
        "smtp": {
          "id": "BdOVsK33NdWdJUob",
          "name": "Gmail SMTP (Mina)"
        }
      },
      "parameters": {
        "fromEmail": "hua19911027@gmail.com",
        "toEmail": "monina1051208@gmail.com",
        "subject": "={{ $json.emailSubject }}",
        "emailType": "text",
        "message": "={{ $json.emailBody }}",
        "options": {}
      },
      "webhookId": "222eb48a-405a-41ff-9ba4-cf5950417234"
    },
    {
      "id": "f3-n7-skip",
      "name": "無待審核 → 結束",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        260,
        440
      ],
      "parameters": {}
    },
    {
      "id": "f3-n8-note",
      "name": "⚙️ 設定說明",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -700,
        100
      ],
      "parameters": {
        "content": "## Flow 3 — 審核截止提醒\n\n**觸發：每月26日 09:00 (Asia/Taipei)**\n\n邏輯：\n1. 查 Notion 題庫中「是否發布=false」的題目\n2. 若有 → 發送 LINE + Email 提醒\n3. 若無 → 直接結束（已全部審核完畢）\n\n**必須設定：**\n\n**1. Notion Practice DB ID**\n與 Flow 2 相同，貼入「查詢待審核題目」節點\n（取代 ⬛TODO_NOTION_PRACTICE_DB_ID）\n\n**2. LINE Notify Token**\n與 Flow 2 相同",
        "height": 300,
        "width": 380,
        "color": 7
      }
    }
  ],
