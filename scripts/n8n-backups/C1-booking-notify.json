      {
        "parameters": {
          "jsCode": "const b = $input.first().json.body ?? $input.first().json;\nconst courseArr = Array.isArray(b.courses) ? b.courses : (Array.isArray(b.subjects) ? b.subjects : []);\nconst courses = courseArr.length > 0 ? courseArr.join('、') : '未填';\nconst studentName = (b.studentName || '').trim() || '未填';\nconst now = new Date().toLocaleString('zh-TW', { timeZone: 'Asia/Taipei' });\n\nconst lineMsg = [\n  '【新試聽預約通知】',\n  `家長：${b.parentName || '未知'}`,\n  `電話：${b.phone || '未填'}`,\n  `學生：${studentName}`,\n  `年級：${b.grade || '未填'}`,\n  `科目：${courses}`,\n  `時段：${b.preferredTime || '不限'}`,\n  `備注：${(b.note || '').trim() || '無'}`,\n  `時間：${now}`\n].join('\\n');\n\nconst emailBody = [\n  '【新試聽預約通知】',\n  '',\n  `家長姓名：${b.parentName || '未知'}`,\n  `聯絡電話：${b.phone || '未填'}`,\n  `學生姓名：${studentName}`,\n  `年級：${b.grade || '未填'}`,\n  `有興趣課程：${courses}`,\n  `希望時段：${b.preferredTime || '不限'}`,\n  `備注：${(b.note || '').trim() || '無'}`,\n  '',\n  `預約時間：${now}`,\n  '',\n  '─────────────────────',\n  '此信由 Mina n8n 自動發送'\n].join('\\n');\n\nreturn [{ json: {\n  lineMsg,\n  emailBody,\n  emailSubject: `【新試聽預約】${b.parentName || '?'} / ${studentName} / ${b.grade || '?'} / ${b.phone || '?'}`\n}}];"
        },
