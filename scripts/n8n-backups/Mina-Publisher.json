    "nodes": [
      {
        "id": "trigger",
        "name": "Hourly Cron",
        "type": "n8n-nodes-base.cron",
        "position": [
          200,
          300
        ],
        "parameters": {
          "triggerTimes": {
            "item": [
              {
                "mode": "everyHour"
              }
            ]
          }
        }
      },
      {
        "id": "get-confirmed",
        "name": "Get Confirmed Posts",
        "type": "n8n-nodes-base.httpRequest",
        "position": [
          450,
          300
        ],
        "parameters": {
          "url": "={{ $env.RAILWAY_URL }}/admin/posts?status=已確認",
          "method": "GET",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Cookie",
                "value": "={{ $env.ADMIN_SESSION_COOKIE }}"
              },
              {
                "name": "x-internal-token",
                "value": "9pL3xW8vN2qR5mT7jK4cB6fY0hD1aU9sE3wI8oN6mZ5"
              }
            ]
          }
        }
      },
      {
        "id": "filter-due",
        "name": "Filter Due Posts",
        "type": "n8n-nodes-base.code",
        "position": [
          700,
          300
        ],
        "parameters": {
          "jsCode": "const now = new Date().toISOString();\nconst posts = $input.first().json.posts || [];\nconst due = posts.filter(p => p.scheduled_time && p.scheduled_time <= now && !p.is_publishing);\nreturn due.map(p => ({ json: p }));"
        }
      },
      {
        "id": "split-posts",
        "name": "Split Posts",
        "type": "n8n-nodes-base.splitInBatches",
        "position": [
          950,
          300
        ],
        "parameters": {
          "batchSize": 1
        }
      },
      {
        "id": "publish-fb",
        "name": "Publish to Facebook",
        "type": "n8n-nodes-base.httpRequest",
        "position": [
          1200,
          200
        ],
        "parameters": {
          "url": "={{ $env.RAILWAY_URL }}/publish/facebook",
          "method": "POST",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Cookie",
                "value": "={{ $env.ADMIN_SESSION_COOKIE }}"
              },
              {
                "name": "x-internal-token",
                "value": "9pL3xW8vN2qR5mT7jK4cB6fY0hD1aU9sE3wI8oN6mZ5"
              }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "post_id",
                "value": "={{ $json.id }}"
              }
            ]
          },
          "options": {
            "timeout": 60000
          }
        }
      },
      {
        "id": "publish-ig",
        "name": "Publish to Instagram",
        "type": "n8n-nodes-base.httpRequest",
        "position": [
          1200,
          400
        ],
        "parameters": {
          "url": "={{ $env.RAILWAY_URL }}/publish/instagram",
          "method": "POST",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Cookie",
                "value": "={{ $env.ADMIN_SESSION_COOKIE }}"
              },
              {
                "name": "x-internal-token",
                "value": "9pL3xW8vN2qR5mT7jK4cB6fY0hD1aU9sE3wI8oN6mZ5"
              }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "post_id",
                "value": "={{ $json.id }}"
              }
            ]
          },
          "options": {
            "timeout": 60000
          }
        }
      },
      {
        "id": "check-ig-time",
        "name": "Check IG Due Time",
        "type": "n8n-nodes-base.if",
        "position": [
          1050,
          400
        ],
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{ $json.ig_scheduled_time <= new Date().toISOString() ? 'yes' : 'no' }}",
                "operation": "equal",
                "value2": "yes"
              }
            ]
          }
        }
      }
    ],
