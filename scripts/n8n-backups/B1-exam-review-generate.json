      {
        "id": "b1-n2",
        "name": "查詢待生題段考",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -700,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://api.notion.com/v1/databases/efbf2f18-2a15-4d9e-bc02-5d32be2e409a/query",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Notion-Version",
                "value": "2022-06-28"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"filter\": {\"and\": [{\"property\": \"分類\", \"select\": {\"equals\": \"段考\"}}, {\"property\": \"已生題\", \"checkbox\": {\"equals\": false}}]}, \"sorts\": [{\"property\": \"日期\", \"direction\": \"ascending\"}], \"page_size\": 100}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "id": "b1-n3",
        "name": "整理考試清單",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -500,
          300
        ],
        "parameters": {
          "jsCode": "const results = ($input.first().json.results || []);\nconst today = new Date();\ntoday.setHours(0,0,0,0);\n\nfunction parseLocal(str) {\n  const [y,m,d] = str.split('-').map(Number);\n  return new Date(y, m-1, d);\n}\nfunction toDateStr(d) {\n  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');\n}\n\nconst rows = results.map(item => ({\n  id: item.id,\n  name: (item.properties?.['名稱']?.title?.[0]?.plain_text || '').trim(),\n  dateStr: item.properties?.['日期']?.date?.start || '',\n})).filter(r => r.name && r.dateStr);\n\nconst groups = {};\nfor (const row of rows) {\n  if (!groups[row.name]) groups[row.name] = [];\n  groups[row.name].push(row);\n}\n\nconst qualifying = [];\nfor (const [name, pages] of Object.entries(groups)) {\n  const dates = pages.map(p => parseLocal(p.dateStr)).sort((a,b)=>a-b);\n  const daysUntil = Math.round((dates[0] - today) / 86400000);\n  if (daysUntil >= 3 && daysUntil <= 21) {\n    qualifying.push({\n      name,\n      pageIds: pages.map(p => p.id),\n      examStart: toDateStr(dates[0]),\n      examEnd:   toDateStr(dates[dates.length-1]),\n      daysUntil,\n    });\n  }\n}\n\n// 無待生題段考 → 停止流程\nif (qualifying.length === 0) return [];\n\n// 只處理最近一場（最多 1 場在窗口內）\nreturn [{ json: qualifying[0] }];"
        }
      },
      {
        "id": "b1-n4",
        "name": "查上次段考結束日",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -300,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://api.notion.com/v1/databases/efbf2f18-2a15-4d9e-bc02-5d32be2e409a/query",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Notion-Version",
                "value": "2022-06-28"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "{\"filter\": {\"and\": [{\"property\": \"分類\", \"select\": {\"equals\": \"段考\"}}, {\"property\": \"已生題\", \"checkbox\": {\"equals\": true}}]}, \"sorts\": [{\"property\": \"日期\", \"direction\": \"descending\"}], \"page_size\": 1}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "id": "b1-n5",
        "name": "計算考試參數",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -100,
          300
        ],
        "parameters": {
          "jsCode": "const exam     = $('整理考試清單').first().json;\nconst prevRows = ($input.first().json.results || []);\n\nfunction parseLocal(str) {\n  const [y,m,d] = str.split('-').map(Number);\n  return new Date(y, m-1, d);\n}\nfunction toDateStr(d) {\n  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');\n}\n\n// 學年開始 = 今年/去年 8/1\nconst today = new Date();\nconst acadYear = (today.getMonth()+1) >= 8 ? today.getFullYear() : today.getFullYear()-1;\nconst acadStart = new Date(acadYear, 7, 1);\n\nconst examStart = parseLocal(exam.examStart);\nconst examEnd   = parseLocal(exam.examEnd);\n\n// rangeStart = 上次段考最後日 +1，否則學年8/1\nlet rangeStartDate;\nif (prevRows.length > 0) {\n  const lastStr = prevRows[0].properties['日期']?.date?.start;\n  rangeStartDate = lastStr ? parseLocal(lastStr) : new Date(acadStart);\n  rangeStartDate.setDate(rangeStartDate.getDate() + 1);\n} else {\n  rangeStartDate = new Date(acadStart);\n}\nconst rangeStart = toDateStr(rangeStartDate);\n\n// rangeEnd = 考試第一天 -1\nconst reDate = new Date(examStart);\nreDate.setDate(reDate.getDate() - 1);\nconst rangeEnd = toDateStr(reDate);\n\n// openAt = 考前那個週六 03:00 +08:00\nfunction prevSat(d) {\n  const t = new Date(d);\n  const dow = t.getDay(); // 0=Sun, 6=Sat\n  t.setDate(t.getDate() - (dow === 6 ? 7 : dow + 1));\n  return t;\n}\n// closeAt = 考完那個週日 23:59 +08:00\nfunction nextSun(d) {\n  const t = new Date(d);\n  const dow = t.getDay();\n  t.setDate(t.getDate() + (dow === 0 ? 7 : 7 - dow));\n  return t;\n}\n\nconst openAt  = toDateStr(prevSat(examStart)) + 'T03:00:00+08:00';\nconst closeAt = toDateStr(nextSun(examEnd))   + 'T23:59:00+08:00';\n\nreturn [{ json: {\n  examName:  exam.name,\n  pageIds:   exam.pageIds,\n  openAt,\n  closeAt,\n  rangeStart,\n  rangeEnd,\n} }];\n"
        }
      },
      {
        "id": "b1-n6",
        "name": "呼叫Worker生題",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          100,
          300
        ],
        "parameters": {
          "method": "POST",
          "url": "https://api.minaedu.tw/api/v1/admin/exam-review/generate",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Admin-Secret",
                "value": "={{ $env.MINA_ADMIN_SECRET }}"
