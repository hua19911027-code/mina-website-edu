          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ examName: $json.examName, openAt: $json.openAt, closeAt: $json.closeAt, rangeStart: $json.rangeStart, rangeEnd: $json.rangeEnd }) }}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        }
      },
      {
        "id": "b1-n7",
        "name": "彙整通知訊息",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          300,
          300
        ],
        "parameters": {
          "jsCode": "const params = $('計算考試參數').first().json;\nconst res    = $input.first().json;\nconst ok     = res.ok !== false && !res.error;\nconst openD  = params.openAt.slice(0,10).replace(/-/g,'/');\nconst closeD = params.closeAt.slice(0,10).replace(/-/g,'/');\nconst msg = ok\n  ? '📋 ' + params.examName + ' 考前複習卷已生成\\n\\n'\n  + '請至 Notion 審核（英數各年級共12份）\\n'\n  + '📅 開放：' + openD + ' ～ ' + closeD\n  : '⚠️ B1 生題失敗\\n考試：' + params.examName + '\\n錯誤：' + (res.error?.message || JSON.stringify(res).slice(0,100));\nreturn [{ json: { msg } }];\n"
        }
      },
