    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "0 3 * * 6"
              }
            ]
          }
        },
        "id": "a2-n1",
        "name": "每週六 03:00",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.2,
        "position": [
          -800,
          304
        ]
      },
      {
        "parameters": {
          "url": "https://api.minaedu.tw/api/v1/admin/settings",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-Admin-Secret",
                "value": "={{ $env.MINA_ADMIN_SECRET }}"
              }
            ]
          },
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n2",
        "name": "讀取出題DB設定",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -608,
          304
        ]
      },
      {
        "parameters": {
          "jsCode": "const s = $('讀取出題DB設定').first().json;\nconst dbId = s.data?.notionPracticeDbId || '';\nconst now = new Date();\nconst today = now.toISOString().split('T')[0];\nconst archiveCutoff = new Date(now - 180 * 24 * 3600 * 1000).toISOString().split('T')[0];\nreturn [{ json: { dbId, today, archiveCutoff } }];"
        },
        "id": "a2-n3",
        "name": "計算目標日期",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -400,
          304
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ 'https://api.notion.com/v1/databases/' + $('計算目標日期').first().json.dbId + '/query' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ filter: { and: [ { property: '發布日期', date: { equals: $('計算目標日期').first().json.today } }, { property: '是否發布', checkbox: { equals: false } } ] }, page_size: 100 }) }}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n4",
        "name": "查詢今日未發布題目",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -208,
          304
        ],
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const res = $input.first().json;\nconst pages = res.results || [];\nif (pages.length === 0) return [{ json: { pageId: '__NONE__' } }];\nreturn pages.map(p => ({ json: { pageId: p.id } }));"
        },
        "id": "a2-n5",
        "name": "拆分今日題目",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          0,
          304
        ]
      },
      {
        "parameters": {
          "method": "PATCH",
          "url": "={{ $json.pageId === '__NONE__' ? 'https://api.notion.com/v1/pages/__NONE__' : 'https://api.notion.com/v1/pages/' + $json.pageId }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"properties\": { \"是否發布\": { \"checkbox\": true } } }",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n6",
        "name": "發布今日題目",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          208,
          304
        ],
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\nconst count = items.filter(i => i.json.object === 'page').length;\nreturn [{ json: { publishedCount: count } }];"
        },
        "id": "a2-n7",
        "name": "計數已發布",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          400,
          304
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ 'https://api.notion.com/v1/databases/' + $('計算目標日期').first().json.dbId + '/query' }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ filter: { and: [ { property: '發布日期', date: { before: $('計算目標日期').first().json.archiveCutoff } }, { property: '已封存', checkbox: { equals: false } }, { property: '是否發布', checkbox: { equals: true } } ] }, page_size: 100 }) }}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n8",
        "name": "查詢應封存題目",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          608,
          304
        ],
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const res = $input.first().json;\nconst pages = res.results || [];\nif (pages.length === 0) return [{ json: { pageId: '__NONE__' } }];\nreturn pages.map(p => ({ json: { pageId: p.id } }));"
        },
        "id": "a2-n9",
        "name": "拆分應封存題目",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          800,
          304
        ]
      },
      {
        "parameters": {
          "method": "PATCH",
          "url": "={{ $json.pageId === '__NONE__' ? 'https://api.notion.com/v1/pages/__NONE__' : 'https://api.notion.com/v1/pages/' + $json.pageId }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "notionApi",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={ \"properties\": { \"已封存\": { \"checkbox\": true } } }",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n10",
        "name": "封存舊題",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1008,
          304
        ],
        "credentials": {
          "notionApi": {
            "id": "AzXLvJt1dpTqr9fB",
            "name": "Notion account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const items = $input.all();\nconst count = items.filter(i => i.json.object === 'page').length;\nreturn [{ json: { archivedCount: count } }];"
        },
        "id": "a2-n11",
        "name": "計數已封存",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          304
        ]
      },
      {
        "parameters": {
          "jsCode": "const pub = $('計數已發布').first().json.publishedCount || 0;\nconst arc = $('計數已封存').first().json.archivedCount || 0;\nconst today = $('計算目標日期').first().json.today;\nconst msg = `✅ 週六自動作業完成（${today}）\\n\\n📢 今日發布：${pub} 題\\n🗄️ 封存舊題：${arc} 題`;\nreturn [{ json: { msg, pub, arc } }];"
        },
        "id": "a2-n12",
        "name": "彙整結果",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1408,
          304
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.line.me/v2/bot/message/broadcast",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "={{ 'Bearer ' + $env.LINE_CHANNEL_ACCESS_TOKEN }}"
              },
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ messages: [{ type: 'text', text: $json.msg }] }) }}",
          "options": {
            "response": {
              "response": {
                "neverError": true
              }
            }
          }
        },
        "id": "a2-n13",
        "name": "通知老師 LINE",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1600,
          304
        ]
      }
