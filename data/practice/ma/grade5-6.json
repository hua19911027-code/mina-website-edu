    {
      "id": "ma-5-002",
      "grade": "小五",
      "subject": "數學",
      "type": "錯題診斷",
      "unit": "次方",
      "question": "計算 -3² 為什麼不是 9？",
      "options": [
        "-3² 就是 9，沒有錯",
        "-3² 是 -(3²)=-9；要得到 9 需要寫 (-3)²",
        "應該是 -6",
        "次方先算，負號後加，所以是 -9"
      ],
      "answer": "B",
      "explanation": {
        "concept": "-3² 是 -(3×3)=-9；要得到 9 必須寫成 (-3)²。",
        "commonMistake": "忽略次方優先於負號，少了括號就算錯。",
        "memoryTip": "沒括號，負號站旁邊看戲，先算次方。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
    {
      "id": "ma-6-001",
      "grade": "小六",
      "subject": "數學",
      "type": "錯題診斷",
      "unit": "括號展開",
      "question": "去括號 -(a-b) 會變成什麼？",
      "options": [
        "-a-b",
        "-a+b",
        "a-b",
        "a+b"
      ],
      "answer": "B",
      "explanation": {
        "concept": "負號要分配到每一項：-(a-b)=-a+b。",
        "commonMistake": "只變第一項符號，寫成 -a-b。",
        "memoryTip": "負號要「雨露均霑」每一項。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
    {
      "id": "ma-6-002",
      "grade": "小六",
      "subject": "數學",
      "type": "觀念拆解",
      "unit": "次方",
      "question": "任何數的 0 次方為什麼是 1？",
      "options": [
        "0 次方定義為 0",
        "由次方相除規律：aⁿ÷aⁿ=a⁰=1（a≠0）",
        "這只是規定沒有理由",
        "0 次方是不合法的運算"
      ],
      "answer": "B",
      "explanation": {
        "concept": "由次方相除規律：aⁿ÷aⁿ=a⁰=1（a≠0）。",
        "commonMistake": "誤以為 0 次方等於 0。",
        "memoryTip": "相同底數相除，指數相減：n-n=0，結果等於 1。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
