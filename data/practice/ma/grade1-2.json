      "subject": "數學",
      "type": "標準題型",
      "unit": "形狀",
      "question": "正方形有幾個角？",
      "options": [
        "3",
        "4",
        "5",
        "6"
      ],
      "answer": "B",
      "explanation": {
        "concept": "正方形有 4 個角、4 條邊，而且每條邊一樣長，每個角都是直角。",
        "commonMistake": "把正方形和三角形的角數搞混。",
        "memoryTip": "正方形＝四邊形，4 條邊就有 4 個角。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
    {
      "id": "ma-1-003",
      "grade": "小一",
      "subject": "數學",
      "type": "觀念拆解",
      "unit": "時間",
      "question": "一小時等於幾分鐘？",
      "options": [
        "30分鐘",
        "60分鐘",
        "100分鐘",
        "24分鐘"
      ],
      "answer": "B",
      "explanation": {
        "concept": "1 小時 = 60 分鐘。時鐘的長針走一圈就是 60 分鐘，也就是 1 小時。",
        "commonMistake": "和一天有 24 小時搞混，誤答 24 分鐘。",
        "memoryTip": "時鐘有 12 格，每格 5 分鐘，12×5=60 分鐘。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    }
  ]
