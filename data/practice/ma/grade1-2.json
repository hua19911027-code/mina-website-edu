      "type": "標準題型",
      "unit": "加法",
      "question": "5 + 3 = ?",
      "options": [
        "6",
        "7",
        "8",
        "9"
      ],
      "answer": "C",
      "explanation": {
        "concept": "5 加 3 等於 8。用手指頭數：5 之後再數 3 個就是 6、7、8。",
        "commonMistake": "加法不熟練時少算一格，算成 7。",
        "memoryTip": "用跳格方式：5→6→7→8，數了 3 格。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
    {
      "id": "ma-1-002",
      "grade": "小一",
      "subject": "數學",
      "type": "標準題型",
      "unit": "減法",
      "question": "10 - 4 = ?",
      "options": [
        "4",
        "5",
        "6",
        "7"
      ],
      "answer": "C",
      "explanation": {
        "concept": "10 減掉 4 剩下 6。10 往回數 4 個：9、8、7、6。",
        "commonMistake": "從 10 往回數時多數一格算成 5。",
        "memoryTip": "用倒數方式：10→9→8→7→6，數了 4 格。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
    {
      "id": "ma-2-001",
      "grade": "小二",
      "subject": "數學",
      "type": "觀念拆解",
      "unit": "比大小",
      "question": "下列哪個數字最大？",
      "options": [
        "15",
        "21",
        "9",
        "18"
      ],
      "answer": "B",
      "explanation": {
        "concept": "比較大小時，先比十位數：21 的十位是 2，其他都是 1 或 0，所以 21 最大。",
        "commonMistake": "只看個位數比較，忘記先比十位數。",
        "memoryTip": "先比最左邊的數字（最高位數）。"
      },
      "publishedAt": "2026-06-01T01:00:00.000Z"
    },
